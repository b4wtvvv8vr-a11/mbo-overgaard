{
  // Serves dist/ behind a code gate (see src/worker.mjs).
  // With no SITE_CODE secret set, the site is served normally.
  "name": "mbo-overgaard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, static files are served before the Worker runs,
    // so the code gate would never see them.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
